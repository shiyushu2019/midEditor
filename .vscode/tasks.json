{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "maven: compile",
      "type": "shell",
      "command": "${workspaceFolder}\\.mvnw.cmd",
      "args": ["-B", "compile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      "label": "maven: test",
      "type": "shell",
      "command": "${workspaceFolder}\\.mvnw.cmd",
      "args": ["-B", "test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "app: run",
      "type": "shell",
      "command": "java",
      "args": ["-cp", "${workspaceFolder}\\target\\classes", "com.example.mideditor.MidiEditorApp"],
      "dependsOn": "maven: compile",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "maven: package",
      "type": "shell",
      "command": "${workspaceFolder}\\.mvnw.cmd",
      "args": ["-B", "package"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "maven: clean",
      "type": "shell",
      "command": "${workspaceFolder}\\.mvnw.cmd",
      "args": ["-B", "clean"],
      "problemMatcher": []
    }
  ]
}
